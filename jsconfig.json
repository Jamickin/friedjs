{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "lib": ["DOM", "ES2022"]
  },
  "include": [
    "app.js",
    "fried.js",
    "addons/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tooling",
    "patcher.js",
    "test.js",
    "stress.js",
    "benchmark.js"
  ]
}
